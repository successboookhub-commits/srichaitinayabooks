DirectoryIndex index.html index.php

# 1. Enable Gzip / Deflate Compression (Reduces JS/CSS download size by 75%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# 2. Ultra-Fast Browser Caching Headers (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 3. HTTP Performance Headers
<IfModule mod_headers.c>
    # Assets immutable cache
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|ico|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Disable ETags for faster 304 validation
    Header unset ETag
    FileETag None
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent rewrite loop on api/index.php
    RewriteRule ^api/index\.php$ - [L]

    # Route /api/ and /invoices/ calls directly to PHP API handler
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api/?$ api/index.php [QSA,L]
    RewriteRule ^invoices/(.*)$ api/index.php [QSA,L]

    # If the file or directory exists locally, serve it directly (CSS, JS, images, storage)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Single Page Application (SPA) routing: send all other requests to index.html
    RewriteRule ^ index.html [L]
</IfModule>
